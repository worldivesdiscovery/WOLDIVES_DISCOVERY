# WORLDIVES DISCOVERY · configuration of the server (copy to .env, never commit .env)
# Every variable is optional in development. In production (WOD_ENV=production) the server refuses to start
# without WOD_PUBLIC_URL (https), WOD_SECRET_KEY and with WOD_ALLOW_SETUP enabled.

# --- Deployment -------------------------------------------------------------
WOD_ENV=development                 # development | staging | demo | production
WOD_PUBLIC_URL=                     # https://worldives.com (origin used for CSRF checks, links in emails, QR and PDFs)
WOD_SECRET_KEY=                     # 32+ random characters (python -c "import secrets;print(secrets.token_urlsafe(48))")
WOD_HOST=127.0.0.1                  # behind nginx/Caddy keep 127.0.0.1
WOD_PORT=8000
WOD_TRUSTED_PROXIES=127.0.0.1       # IPs/CIDRs of the reverse proxy; only then X-Forwarded-For/Proto are trusted
WOD_WORKERS=1                       # Linux: several processes sharing the port
WOD_DB_PATH=                        # default data/worldivesdiscovery.sqlite3
WOD_STORAGE_DIR=                    # private documents (default storage/), never inside public/
WOD_LOG_DIR=                        # default logs/
WOD_ACCESS_LOG=file                 # file | stdout | off
WOD_LOG_RETENTION_DAYS=14           # access logs (with truncated IPs) are kept this many days
WOD_LOG_IP=truncated                # truncated | full | none
WOD_ALLOWED_ORIGINS=                # extra origins allowed to POST (comma separated), normally empty

# --- First administrator ----------------------------------------------------
# Production: python app/server.py --create-admin --email you@domain --username admin --name "Your Name"
WOD_ALLOW_SETUP=0                   # 1 only on a brand-new local install to use the web installer (#/setup)
WOD_ADMIN_TOTP_REQUIRED=1           # administrators must use two-step verification

# --- Limits -------------------------------------------------------------------
WOD_MAX_JSON_BYTES=1048576          # 1 MB for JSON requests
WOD_MAX_UPLOAD_MB=15                # multipart uploads
WOD_MAX_DOCUMENT_MB=10              # private documents (PDF/JPG/PNG/WEBP)
WOD_MAX_VIRTUAL_UPLOAD_MB=15        # 360° panoramas and videos
WOD_REGISTER_MAX_PER_HOUR=10        # new accounts per IP and hour
WOD_SESSION_TTL_SECONDS=28800
WOD_EMBED_DOMAINS=youtube-nocookie.com,player.vimeo.com,google.com/maps   # allowed virtual-tour embeds

# --- Demo / pilot -------------------------------------------------------------
WOD_DEMO_MODE=0                     # 1 = demo ribbon, no real payments, no registration, noindex
WOD_REGISTRATION_CLOSED=0

# --- Stripe Connect (direct charges, no platform fee) ------------------------
STRIPE_SECRET_KEY=                  # sk_test_… / sk_live_…
STRIPE_WEBHOOK_SECRET=              # whsec_… of the platform endpoint /api/payments/webhook
STRIPE_CONNECT_WEBHOOK_SECRET=      # whsec_… of the Connect endpoint /api/payments/webhook/connect
WOD_PAYMENT_HOLD_MINUTES=15         # spots held while a diver pays
WOD_STRIPE_DASHBOARD=full           # connected accounts: full Stripe Dashboard (full | express | none)
WOD_STRIPE_FEES_PAYER=account       # Stripe processing fees paid by the connected account (account | application)
WOD_STRIPE_LOSSES=stripe            # negative balances: Stripe (stripe | application)
WOD_STRIPE_CAPABILITIES=card_payments
# WOD_STRIPE_API_BASE=              # only for tests: a local Stripe simulator

# --- Email (any SMTP provider; recommended: Brevo) ---------------------------
WOD_SMTP_HOST=
WOD_SMTP_PORT=587
WOD_SMTP_SECURITY=starttls          # starttls | ssl | none
WOD_SMTP_USER=
WOD_SMTP_PASSWORD=
WOD_MAIL_FROM=
WOD_MAIL_FROM_NAME=WORLDIVES DISCOVERY
WOD_MAIL_REPLY_TO=
WOD_MAIL_FILE_DIR=                  # without SMTP: emails are written here as .eml (default in development: data/mail-outbox)

# --- Maps ---------------------------------------------------------------------
WOD_PMTILES_URL=/tiles/worldives.pmtiles   # own base map (Protomaps PMTiles), see docs/despliegue.md
ARCGIS_API_KEY=                     # Esri World Imagery (satellite layer). Without a key the satellite layer is hidden.
WOD_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# --- Monitoring / backups -----------------------------------------------------
WOD_ALERT_ERRORS=5                  # this many 500 errors…
WOD_ALERT_WINDOW_MIN=10             # …within these minutes send one alert email to the administrators
WOD_BACKUP_DIR=                     # hourly database copies + daily uploads (see docs/despliegue.md)

# --- Points (Fase 3) -----------------------------------------------------------
WOD_POINTS_CODE_DAYS=180                      # validity of an exchange code; unused codes give the points back
WOD_POINTS_GRANT_MAX_PER_CLIENT_MONTH=100     # points a centre can grant to one client per month
WOD_POINTS_GRANT_MAX_PER_CENTER_MONTH=3000    # points a centre can grant in total per month
