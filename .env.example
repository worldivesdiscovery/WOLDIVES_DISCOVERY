# WORLDIVES DISCOVERY · configuration of the server (copy to .env, never commit .env)
# Every variable is optional in development. In production (WOD_ENV=production) the server refuses to start
# without WOD_PUBLIC_URL (https), WOD_SECRET_KEY and with WOD_ALLOW_SETUP enabled.
# The server reads this file (.env next to the application, or WOD_ENV_FILE) by itself. Variables already set in
# the environment win. An empty variable means «not set» (the default or the recommended value applies).
# Inline «# comments» are allowed. Keys and passwords go ONLY in the server's .env, never in the code or the repository.
# A missing optional key (mail, payments, maps, WhatsApp, push…) only switches that function off; the rest of the web
# works. Administración → Operación → «Estado del sistema» shows each service (configured / pending / error) and the
# variable that switches it on. Changes in this file are applied when the server restarts (sudo systemctl restart worldives).

# --- Deployment -------------------------------------------------------------
WOD_ENV=                            # recomendado: development · development | staging | demo | production
WOD_PUBLIC_URL=                     # https://worldivesdiscovery.com (origin used for CSRF checks, links in emails, QR and PDFs)
WOD_SECRET_KEY=                     # 32+ random characters (python -c "import secrets;print(secrets.token_urlsafe(48))")
# v50.47: key that encrypts the divers' phones and the WhatsApp credentials of each centre (AES-GCM). Obligatory in
# production. Keep a copy outside the server: without it the encrypted phones cannot be read. To rotate it: put the
# new key here, the old one in WOD_DATA_KEY_OLD and run python scripts/seguridad/rotar_clave_datos.py --aplicar (server stopped).
WOD_DATA_KEY=                       # python -c "import secrets;print(secrets.token_urlsafe(32))"
WOD_DATA_KEY_OLD=                   # previous keys (comma separated), only while rotating
WOD_HOST=                           # recomendado: 127.0.0.1 · behind nginx/Caddy keep 127.0.0.1
WOD_PORT=                           # recomendado: 8000
WOD_TRUSTED_PROXIES=                # recomendado: 127.0.0.1 · IPs/CIDRs of the reverse proxy; only then X-Forwarded-For/Proto are trusted
WOD_WORKERS=                        # recomendado: 1 · Linux: several processes sharing the port
WOD_DB_PATH=                        # default data/worldivesdiscovery.sqlite3
WOD_STORAGE_DIR=                    # private documents (default storage/), never inside public/
WOD_LOG_DIR=                        # default logs/
WOD_ACCESS_LOG=                     # recomendado: file · file | stdout | off
WOD_LOG_RETENTION_DAYS=             # recomendado: 14 · access logs (with truncated IPs) are kept this many days
WOD_LOG_IP=                         # recomendado: truncated · truncated | full | none
WOD_ALLOWED_ORIGINS=                # extra origins allowed to POST (comma separated), normally empty

# --- First administrator ----------------------------------------------------
# Production: python app/server.py --create-admin --email you@domain --username admin --name "Your Name"
WOD_ALLOW_SETUP=                    # recomendado: 0 · 1 only on a brand-new local install to use the web installer (#/setup)
WOD_ADMIN_TOTP_REQUIRED=            # recomendado: 1 · administrators must use two-step verification
WOD_PAYMENTS_TOTP_REQUIRED=         # recomendado: 1 (0 no se permite en producción) · centres/freelance with online payments and team members with «Cobros» must use it (v50.52)

# --- Limits -------------------------------------------------------------------
WOD_MAX_JSON_BYTES=                 # recomendado: 1048576 · 1 MB for JSON requests
WOD_MAX_UPLOAD_MB=                  # recomendado: 15 · multipart uploads
WOD_MAX_DOCUMENT_MB=                # recomendado: 10 · private documents (PDF/JPG/PNG/WEBP)
WOD_AV_COMMAND=                     # recomendado: clamdscan --no-summary --fdpass - · antivirus for uploaded documents (exit 1 = virus)
WOD_MAX_VIRTUAL_UPLOAD_MB=          # recomendado: 15 · 360° panoramas and videos
WOD_REGISTER_MAX_PER_HOUR=          # recomendado: 10 · new accounts per IP and hour
WOD_SESSION_TTL_SECONDS=            # recomendado: 28800 · longest a session lasts, even in use (8 h)
WOD_SESSION_IDLE_SECONDS=           # recomendado: 14400 · a session unused this long ends (4 h)
WOD_LOGIN_MAX_ATTEMPTS=             # recomendado: 8 · wrong passwords per account and address (x5 per address, x3 per account)
WOD_LOGIN_WINDOW_SECONDS=           # recomendado: 900 · window of those limits (docs/seguridad/autenticacion.md)
WOD_EMBED_DOMAINS=                  # recomendado: youtube-nocookie.com,player.vimeo.com,google.com/maps · allowed virtual-tour embeds

# --- Demo / pilot -------------------------------------------------------------
# The test environment (zip «-pruebas») sets these in iniciar-pruebas. Never enable demo mode on the real server:
# the server refuses to start with WOD_DEMO_MODE=1 on the production address or with a real Stripe key.
WOD_DEMO_MODE=                      # recomendado: 0 · 1 = demo ribbon, no real payments, no registration, noindex
WOD_PRODUCTION_HOSTS=                # extra production hosts (comma separated) besides worldivesdiscovery.com and its subdomains
WOD_EMPTY_DB=                       # 1 = first start with an empty database (no catalogue seed)
WOD_REGISTRATION_CLOSED=            # recomendado: 0

# --- Stripe Connect (direct charges, no platform fee) ------------------------
STRIPE_SECRET_KEY=                  # sk_test_… / sk_live_…
STRIPE_WEBHOOK_SECRET=              # whsec_… of the platform endpoint /api/payments/webhook
STRIPE_CONNECT_WEBHOOK_SECRET=      # whsec_… of the Connect endpoint /api/payments/webhook/connect
STRIPE_PUBLISHABLE_KEY=             # v50.58 (reserva exprés): pk_test_… / pk_live_…, the same mode as STRIPE_SECRET_KEY. With it, the payment
                                    # opens inside the booking (Stripe's form, Apple Pay / Google Pay / Link); empty: Stripe's page, as before
WOD_PAYMENT_HOLD_MINUTES=           # recomendado: 10 · spots held while a diver pays (any channel: WORLDIVES, widget, link, API)
WOD_STRIPE_DASHBOARD=               # recomendado: full · connected accounts: full Stripe Dashboard (full | express | none)
WOD_STRIPE_FEES_PAYER=              # recomendado: account · Stripe processing fees paid by the connected account (account | application)
WOD_STRIPE_LOSSES=                  # recomendado: stripe · negative balances: Stripe (stripe | application)
WOD_STRIPE_CAPABILITIES=            # recomendado: card_payments
# WOD_STRIPE_API_BASE=              # only for tests: a local Stripe simulator

# --- Email (any SMTP provider; recommended: Brevo) ---------------------------
WOD_SMTP_HOST=                      
WOD_SMTP_PORT=                      # recomendado: 587
WOD_SMTP_SECURITY=                  # recomendado: starttls · starttls | ssl | none
WOD_SMTP_USER=                      
WOD_SMTP_PASSWORD=                  
WOD_MAIL_FROM=                      
WOD_MAIL_FROM_NAME=                 # recomendado: WORLDIVES DISCOVERY
WOD_MAIL_REPLY_TO=                  
WOD_MAIL_FILE_DIR=                  # without SMTP: emails are written here as .eml (default in development: data/mail-outbox)

# --- Maps ---------------------------------------------------------------------
WOD_PMTILES_URL=                    # recomendado: /tiles/worldives.pmtiles · own base map (Protomaps PMTiles), see docs/mapas.md
WOD_TILES_DIR=                      # folder of the .pmtiles file (default data/tiles)
WOD_PMTILES_MAXZOOM=                # recomendado: 14 · highest zoom stored in the file (the map zooms further by enlarging it)
# Esri World Imagery (satellite) through ArcGIS Location Platform. Only here, in the server's .env: NEVER in the
# code or the repository. Without a key «Satélite» is shown disabled («Disponible próximamente»). Monthly limit:
# Administración → Mapas.
ARCGIS_API_KEY=                     
WOD_GEBCO_LAYER=                    # recomendado: GEBCO_LATEST · «Relieve»: GEBCO_LATEST (shaded relief) or GEBCO_LATEST_2 (colour)
WOD_GEOCODER_URL=                   # recomendado: https://nominatim.openstreetmap.org/search

# --- Monitoring / backups -----------------------------------------------------
WOD_ALERT_ERRORS=                   # recomendado: 5 · this many 500 errors…
WOD_ALERT_WINDOW_MIN=               # recomendado: 10 · …within these minutes send one alert email to the administrators
WOD_BACKUP=                         # recomendado: on · off disables the automatic copies (never in production)
WOD_BACKUP_DIR=                     # hourly database copies + daily uploads (default data/backups; see docs/despliegue/README.md)
WOD_BACKUP_DB_MINUTES=              # recomendado: 60 · database copy every N minutes
WOD_BACKUP_KEEP_HOURLY=             # recomendado: 48 · rotation: hourly copies kept…
WOD_BACKUP_KEEP_DAILY=              # recomendado: 30 · …one per day for N days…
WOD_BACKUP_KEEP_MONTHLY=            # recomendado: 12 · …and one per month for N months
WOD_BACKUP_COMMAND=                 # sends each copy outside the server, e.g. /opt/worldives/scripts/copia_externa.sh
WOD_BACKUP_KEY=                     # v50.51 · encrypts every copy (AES-256-GCM). python -c "import secrets;print(secrets.token_urlsafe(32))".
                                    # Keep it ALSO outside the server (password manager): without it a copy cannot be restored.
WOD_TIMEZONE=                       # recomendado: Europe/Madrid · reloj del servidor aunque el VPS vaya en UTC, y zona de los
                                    # centros sin país conocido (cada salida se compara siempre con la hora de su centro)

# --- WhatsApp Business (v50.47: notices of the centres) -----------------------
# Each centre connects ITS OWN WhatsApp Business number from its panel (Embedded Signup of Meta): the notices of a centre
# leave only from its number and the replies reach the centre directly. WORLDIVES needs a Meta app as «Tech Provider»
# (steps in docs/notas-de-version/v50.47.md, «Para el titular»). Until everything below is filled in and
# WHATSAPP_ENABLED=1, the centres send their notices by email and in the app only. The tokens of each centre are stored
# encrypted in the database (WOD_DATA_KEY), never here.
WHATSAPP_ENABLED=                   # recomendado: 0 · 1 only when the Meta app is approved and the values below are set
WHATSAPP_APP_ID=                    # App ID of the Meta app (developers.facebook.com → your app → Settings → Basic)
WHATSAPP_APP_SECRET=                # App secret of the same page (also signs the webhooks: X-Hub-Signature-256)
WHATSAPP_VERIFY_TOKEN=              # any random text; the same in Meta → WhatsApp → Configuration → Webhook (verify token)
WHATSAPP_CONFIG_ID=                 # configuration id of the Embedded Signup (Facebook Login for Business → Configurations)
WHATSAPP_GRAPH_VERSION=             # recomendado: v23.0
WHATSAPP_COEX_UNAVAILABLE=          # recomendado: NG,ZA · countries (ISO) where the WhatsApp Business app cannot share the number
# WHATSAPP_GRAPH_BASE=              # only for tests: a local imitation of the Graph API

# --- Mass notices (v50.47) -----------------------------------------------------
WOD_AVISOS_MAX_DIA=                 # recomendado: 10 · mass notices (cancellations and changes) one centre can send per day
WOD_AVISOS_ALERTA_DESTINATARIOS=    # recomendado: 60 · a notice to more divers than this alerts the administrator
WOD_AVISOS_ALERTA_CANCELACIONES=    # recomendado: 5 · this many cancelled departures of one centre in a day alerts the administrator
WOD_AVISOS_DESHACER_SEGUNDOS=       # recomendado: 10 · seconds to undo before anything leaves

# --- Points (Fase 3) -----------------------------------------------------------
WOD_POINTS_CODE_DAYS=               # recomendado: 180 · validity of an exchange code; unused codes give the points back
WOD_POINTS_GRANT_MAX_PER_CLIENT_MONTH=# recomendado: 100 · points a centre can grant to one client per month
WOD_POINTS_GRANT_MAX_PER_CENTER_MONTH=# recomendado: 3000 · points a centre can grant in total per month

# --- Push notices of the app (Firebase Cloud Messaging) ----------------------------
# Without these the app shows its notices when it is opened; nothing else changes.
WOD_FCM_PROJECT_ID=                 # project id of Firebase (console.firebase.google.com → Project settings)
WOD_FCM_CREDENTIALS=                # path to the service-account JSON file of that project, outside public/ (chmod 600)

# --- Route videos (v50.50) ------------------------------------------------------
WOD_VIDEO_EMBED_OFF=                # platforms whose player is never embedded (they open in a new tab), e.g. facebook,instagram

# --- Connected devices (v50.55) ---------------------------------------------------
# «Dispositivos conectados» shows an approximate city only when the reverse proxy adds it in a header (the server
# never looks the IP up by itself). Empty: no city. With Cloudflare in front: CF-IPCity («Add visitor location headers»).
WOD_GEOIP_HEADER=                   # recomendado: vacío · name of the header with the city, e.g. CF-IPCity
