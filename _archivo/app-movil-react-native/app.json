{
  "expo": {
    "name": "WORLDIVES",
    "slug": "worldives",
    "version": "0.1.0",
    "scheme": "worldives",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#041526",
    "ios": {
      "bundleIdentifier": "com.worldivesdiscovery.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.worldivesdiscovery.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#011C3C"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.VIBRATE"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#041526"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "WORLDIVES usa la cámara para escanear el QR de las reservas en el muelle.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
